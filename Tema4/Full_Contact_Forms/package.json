    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.93.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
